# ==========================================
# Server Configuration
# ==========================================
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
ADMIN_API_KEY=change-this-to-a-secure-random-32-char-token

# ==========================================
# Firebase Configuration
# ==========================================
# Database engine: 'firestore' (default) or 'realtime'
FIREBASE_DATABASE_TYPE=firestore
FIREBASE_PROJECT_ID=my-portfolio-e1326
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@my-portfolio-e1326.iam.gserviceaccount.com
# Format private key with newline characters or escaped \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Optional: Path to service account JSON file if not using individual env vars
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional: Realtime DB URL if FIREBASE_DATABASE_TYPE=realtime
FIREBASE_DATABASE_URL=https://my-portfolio-e1326-default-rtdb.firebaseio.com
# Optional: Multi-tenant filter (leave empty if single tenant)
TENANT_ID=

# ==========================================
# Zoho ERP / Finance / CRM Configuration
# ==========================================
# Target Product: 'zoho_books' (default) | 'zoho_inventory' | 'zoho_crm'
ZOHO_PRODUCT=zoho_books

# Zoho OAuth 2.0 Credentials (obtain from https://api-console.zoho.com)
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Zoho Data Center Endpoints
# US: https://accounts.zoho.com | IN: https://accounts.zoho.in | EU: https://accounts.zoho.eu
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Base API URL:
# For Books: https://www.zohoapis.com/books/v3 (or .in, .eu)
# For Inventory: https://www.zohoapis.com/inventory/v3
# For CRM: https://www.zohoapis.com/crm/v6
ZOHO_API_BASE_URL=https://www.zohoapis.com/books/v3

# Organization ID (Required for Zoho Books and Zoho Inventory; not required for Zoho CRM)
ZOHO_ORGANIZATION_ID=123456789

# ==========================================
# Synchronization & Worker Settings
# ==========================================
# Cron schedule for incremental sync (e.g. '*/5 * * * *' = every 5 minutes)
SYNC_SCHEDULE=*/5 * * * *

# Cron schedule for full reconciliation (e.g. '0 2 * * *' = daily at 2:00 AM)
RECONCILIATION_SCHEDULE=0 2 * * *

# Number of Firebase documents to process per batch
SYNC_BATCH_SIZE=50

# Maximum retry attempts per failed document before requiring manual review
SYNC_MAX_RETRIES=5

# Retry backoff multiplier in milliseconds (base backoff)
SYNC_RETRY_BASE_DELAY_MS=2000

# Set to 'true' to validate and log mapping without writing to Zoho
SYNC_DRY_RUN=false

# Distributed lock duration in seconds (prevent overlapping multi-instance runs)
SYNC_LOCK_TTL_SECONDS=300

# ==========================================
# AWS Secret Manager Integration (Optional)
# ==========================================
# If deployed on AWS ECS / Lambda / App Runner and fetching secrets from AWS Secrets Manager
AWS_REGION=us-east-1
AWS_SECRET_NAME=
