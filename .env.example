# ==========================================
# Server Configuration
# ==========================================
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
ADMIN_API_KEY=change-this-to-a-secure-random-32-char-token

# ==========================================
# Firebase Configuration
# ==========================================
# Database engine: 'firestore' (default) or 'realtime'
FIREBASE_DATABASE_TYPE=firestore
FIREBASE_PROJECT_ID=my-portfolio-e1326

# Option A (Recommended): Path to downloaded service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Option B: Individual service account credentials
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
# Optional: Multi-tenant filter (leave empty if single tenant)
TENANT_ID=

# Firebase Client / Web Credentials (from CRM frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAxsfNQS-gBvJRH53kHyaz3vX6v9luGPzw
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=my-portfolio-e1326.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=my-portfolio-e1326
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=my-portfolio-e1326.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="52052484030"
NEXT_PUBLIC_FIREBASE_APP_ID="1:52052484030:web:1fff36b48d3edbfac2e3ef"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-MNDHQ24B0Y"

# ==========================================
# Zoho ERP / Finance / CRM Configuration
# ==========================================
# Target Product: 'zoho_erp' (default) | 'zoho_books' | 'zoho_inventory' | 'zoho_crm'
ZOHO_PRODUCT=zoho_erp

# Zoho OAuth 2.0 Credentials (obtain from https://api-console.zoho.in)
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REDIRECT_URI=http://localhost:3000/api/zoho/callback
ZOHO_REFRESH_TOKEN=
ZOHO_OAUTH_SCOPES=ERP.contacts.ALL,ERP.salesorders.ALL,ERP.estimates.ALL,ERP.manufacturing.ALL,ERP.settings.ALL

# Zoho Data Center Endpoints
# IN (India): https://accounts.zoho.in | US: https://accounts.zoho.com | EU: https://accounts.zoho.eu
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in

# Base API URL:
# For Zoho ERP (IN): https://www.zohoapis.in/erp/v3
# For Books (IN): https://www.zohoapis.in/books/v3
# For Books (US): https://www.zohoapis.com/books/v3
ZOHO_API_BASE_URL=https://www.zohoapis.in/erp/v3

# Organization ID (Required for Zoho ERP, Books, and Inventory)
ZOHO_ORGANIZATION_ID=your_zoho_organization_id_here

# ==========================================
# Synchronization & Worker Settings
# ==========================================
# Cron schedule for incremental sync (e.g. '*/5 * * * *' = every 5 minutes)
SYNC_SCHEDULE=*/5 * * * *

# Cron schedule for full reconciliation (e.g. '0 2 * * *' = daily at 2:00 AM)
RECONCILIATION_SCHEDULE=0 2 * * *

# Number of Firebase documents to process per batch
SYNC_BATCH_SIZE=50

# Maximum retry attempts per failed document before requiring manual review
SYNC_MAX_RETRIES=5

# Retry backoff multiplier in milliseconds (base backoff)
SYNC_RETRY_BASE_DELAY_MS=2000

# Set to 'true' to validate and log mapping without writing to Zoho
SYNC_DRY_RUN=false

# Distributed lock duration in seconds (prevent overlapping multi-instance runs)
SYNC_LOCK_TTL_SECONDS=300

# ==========================================
# AWS Secret Manager Integration (Optional)
# ==========================================
# If deployed on AWS ECS / Lambda / App Runner and fetching secrets from AWS Secrets Manager
AWS_REGION=us-east-1
AWS_SECRET_NAME=
